# Порт, на котором приложение будет доступно снаружи.
APP_PORT=3000

# Логин и пароль администратора.
# Применяются только при первом запуске на пустой базе.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# Секрет для подписи сессий (длинная случайная строка).
SESSION_SECRET=change-me-to-a-long-random-string
