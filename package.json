{
  "name": "moonshinewiki",
  "version": "1.0.0",
  "description": "MoonshineWiki — минималистичная база знаний о домашнем самогоноварении, виноделии и пивоварении (PWA)",
  "private": true,
  "type": "commonjs",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "seed": "node seed.js",
    "export": "node scripts/export-data.js",
    "import": "node scripts/import-data.js",
    "backup": "bash backup.sh"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^13.0.3",
    "dompurify": "^3.4.14",
    "express": "^5.2.1",
    "express-session": "^1.19.0",
    "marked": "^18.0.11"
  }
}
